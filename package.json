{
  "name": "odm-supplier-visit",
  "version": "0.1.0",
  "private": true,
  "description": "EBARA Global Sourcing Office \u2014 factory visit documentation, supplier master data and corporate DOCX visit reports.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "gen:placeholders": "node scripts/generate-photo-placeholders.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "validate:backend": "node --env-file=.env.local scripts/validate-backend.mjs",
    "create-admin": "node --env-file=.env.local scripts/create-admin.mjs",
    "audit:seed": "node --env-file=.env.local scripts/audit-seed.mjs",
    "audit:clean": "node --env-file=.env.local scripts/audit-seed.mjs --clean",
    "audit:export": "vitest run --config vitest.audit.config.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "^2.1.1",
    "docx": "^9.8.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
