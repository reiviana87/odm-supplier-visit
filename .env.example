# ─────────────────────────────────────────────────────────────────────────────
# ODM Supplier Visit — environment configuration
#
# Copy to `.env.local` and fill in the real values. `.env.local` is gitignored
# and must never be committed.
#
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL and publishable key. Both are safe to expose to the browser —
# row level security is what protects the data, not the key.
# Find them in the Supabase dashboard under Project Settings › API keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Secret key. SERVER ONLY — it bypasses row level security.
# Never prefix it with NEXT_PUBLIC_: that prefix is what tells the bundler to
# inline a value into the client bundle, so prefixing this one would publish
# it. Never import it into a client component. Used by the seed and backend
# validation scripts. Leave empty in environments that do not need it.
SUPABASE_SECRET_KEY=

# ── Application ──────────────────────────────────────────────────────────────
# Absolute origin of this deployment. Used to build auth redirect URLs.
# Local: http://localhost:3000 · Vercel: https://<project>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# When "true" the app runs against the seeded demo data in
# src/lib/mock-data and never calls Supabase. Phase 1 ships with this on so
# the approved screens render without a provisioned backend.
NEXT_PUBLIC_USE_MOCK_DATA=true

# ── Not used in Phase 1 ──────────────────────────────────────────────────────
# Declared here so the deployment contract is visible, but nothing reads them
# yet (README "Intentionally not implemented").
# ANTHROPIC_API_KEY=
